{
  "schema_version": 1,
  "profiles": {
    "lite": {
      "description": "Small, low-risk work with reduced governance overhead.",
      "external_provenance_required": false
    },
    "standard": {
      "description": "Default DXM project governance profile.",
      "external_provenance_required": false
    },
    "high-assurance": {
      "description": "High-risk work that requires externally verifiable provenance evidence.",
      "external_provenance_required": true
    }
  },
  "limits": {
    "inventory_max_depth": 8,
    "inventory_max_entries": 1000,
    "inventory_max_bytes": 262144,
    "inventory_timeout_seconds": 5,
    "trellis_timeout_max_seconds": 900,
    "trellis_user_max_length": 128,
    "lock_stale_seconds": 1800
  }
}
